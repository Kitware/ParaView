  <pqcheck object="pqClientMainWindow/findDataDock/findDataScrollArea/scrollArea/qt_scrollarea_viewport/findDataWidget/selectionDisplayProperties/ProxyWidgetDialog/scrollArea/qt_scrollarea_viewport/Container/ProxyWidget/SelectionLineWidth/DoubleLineEdit0" property="text" arguments="2" />
