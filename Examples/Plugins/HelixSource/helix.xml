<ServerManagerConfiguration>
  <ProxyGroup name="sources">
    <SourceProxy name="HelixSource" class="vtkPythonProgrammableFilter"
                 label="Helix Source">
      <Documentation
         long_help="Creates a helix using a configurable python script."
         short_help="Creates a helix.">
           This source will execute a python script to produce a helix dataset.
           It provides properties to control script variables.
      </Documentation>

      <!-- data set type: enforce vtkPolyData -->
      <IntVectorProperty
        name="OutputDataSetType"
        command="SetOutputDataSetType"
        number_of_elements="1"
        panel_visibility="never"
        default_values="0">
        <!-- value of 0 means vtkPolyData -->
      </IntVectorProperty>

      <!-- the script, hidden by default -->
      <StringVectorProperty
        name="Script"
        command="SetScript"
        number_of_elements="1"
        panel_visibility="advanced"
        default_values="import math;&#xa;pdo = self.GetPolyDataOutput()&#xa;&#xa;coord = [0, 0, 0]&#xa;newPts = vtk.vtkPoints()&#xa;for i in range(0, numPts):&#xa;   coord[axis] = i*float(length)/float(numPts)&#xa;   coord[axis-2] = math.sin(i*rounds*2*math.pi/numPts)&#xa;   coord[axis-1] = math.cos(i*rounds*2*math.pi/numPts)&#xa;   newPts.InsertPoint(i, coord)&#xa;&#xa;pdo.SetPoints(newPts)&#xa;aPolyLine = vtk.vtkPolyLine()&#xa;&#xa;aPolyLine.GetPointIds().SetNumberOfIds(numPts)&#xa;for i in range(0,numPts):&#xa;   aPolyLine.GetPointIds().SetId(i, i)&#xa;&#xa;pdo.Allocate(1, 1)&#xa;pdo.InsertNextCell(aPolyLine.GetCellType(), aPolyLine.GetPointIds())&#xa;">
        <Hints>
          <Widget type="multi_line"/>
        </Hints>
      </StringVectorProperty>

      <!-- Set the `initial_string` attribute to a variable name of the script to init it. -->
      <IntVectorProperty
        name="NumberOfPoints"
        command="SetParameter"
        number_of_elements="1"
        animateable="1"
        initial_string="numPts"
        default_values="80" >
        <IntRangeDomain min="10"
                        name="range" />
        <Documentation>
          The number of output points.
        </Documentation>
      </IntVectorProperty>

      <!-- Set the `initial_string` attribute to a variable name of the script to init it. -->
      <IntVectorProperty
        name="Axis"
        command="SetParameter"
        number_of_elements="1"
        initial_string="axis"
        default_values="0">
        <EnumerationDomain name="enum">
          <Entry text="X"
                 value="0" />
          <Entry text="Y"
                 value="1" />
          <Entry text="Z"
                 value="2" />
        </EnumerationDomain>
      </IntVectorProperty>

      <!-- Set the `initial_string` attribute to a variable name of the script to init it. -->
      <DoubleVectorProperty
        name="Length"
        command="SetParameter"
        number_of_elements="1"
        animateable="1"
        initial_string="length"
        default_values="2.0" >
        <DoubleRangeDomain max="10"
                           min="0"
                           name="range" />
      </DoubleVectorProperty>

      <!-- Set the `initial_string` attribute to a variable name of the script to init it. -->
      <IntVectorProperty
        name="NumberOfRounds"
        command="SetParameter"
        number_of_elements="1"
        animateable="1"
        initial_string="rounds"
        default_values="3" >
        <IntRangeDomain min="0"
                        max="20"
                        name="range" />
      </IntVectorProperty>
    </SourceProxy>
  </ProxyGroup>
</ServerManagerConfiguration>
